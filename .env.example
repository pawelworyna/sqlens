# Przykładowe profile połączeń dla SQLens MCP
# Możesz odwołać się do nazwy zmiennej bezpośrednio w prompcie (np. "Sprawdź tabelę Users w bazie MSSQL_LOCAL")

# 1. SQLite (ścieżka do pliku)
SQLITE_DEMO="C:/sciezka/do/bazy.db"

# 2. SQL Server (Windows Authentication przez ODBC)
MSSQL_LOCAL="Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=MojaBaza;Trusted_Connection=yes;TrustServerCertificate=yes;"

# 3. SQL Server (SQL Authentication przez pymssql - nie wymaga sterownika ODBC w systemie)
MSSQL_PROD="mssql+pymssql://uzytkownik:haslo@serwer.domena.pl:1433/MojaBaza"

# 4. PostgreSQL (opcjonalnie - wymaga: pip install -e ".[postgres]")
POSTGRES_DEV="postgresql+psycopg://uzytkownik:haslo@localhost:5432/moja_baza"

# 5. MySQL / MariaDB (opcjonalnie - wymaga: pip install -e ".[mysql]")
MYSQL_DEV="mysql+pymysql://uzytkownik:haslo@localhost:3306/moja_baza"
