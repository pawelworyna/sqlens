# Example connection profiles for SQLens MCP Server
# Copy this file to `.env` and reference the variable name directly in your prompt
# (e.g., "Check the Users table in database MSSQL_LOCAL")

# 1. SQLite (path to local database file)
SQLITE_DEMO="C:/path/to/database.db"

# 2. SQL Server (Windows Authentication via ODBC)
MSSQL_LOCAL="Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=MyDatabase;Trusted_Connection=yes;TrustServerCertificate=yes;"

# 3. SQL Server (SQL Authentication via pymssql - does not require system ODBC drivers)
MSSQL_PROD="mssql+pymssql://username:password@server.domain.local:1433/MyDatabase"

# 4. PostgreSQL (optional - requires: pip install -e ".[postgres]")
POSTGRES_DEV="postgresql+psycopg://username:password@localhost:5432/my_database"

# 5. MySQL / MariaDB (optional - requires: pip install -e ".[mysql]")
MYSQL_DEV="mysql+pymysql://username:password@localhost:3306/my_database"
